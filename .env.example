# --- Agente ---
AGENT_NAME=SERVERFASA
POLL_SECONDS=2

# --- MySQL (ERP FASA) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fasa_erp
DB_USER=fasa_print
DB_PASSWORD=CHANGEME

# --- Impresión Windows ---
# Ruta opcional a SumatraPDF para imprimir PDFs desde consola/servicio.
# Si está vacío se usa ShellExecute(print) como fallback.
SUMATRA_PDF_PATH=
# Tiempo máx. de espera del proceso de impresión (segundos)
PRINT_TIMEOUT_SECONDS=60
# Impresora por defecto para --test-printer si no se pasa argumento
DEFAULT_TEST_PRINTER=

# --- Tipos permitidos (coma separada). MVP: solo REMITO_CTACTE ---
ALLOWED_TIPOS_IMPRESION=REMITO_CTACTE
ALLOWED_DOCUMENTO_TIPOS=REMITO
MAX_COPIAS=5

# --- Logs ---
LOG_LEVEL=INFO
LOG_DIR=C:\ProgramData\FASA Print Agent\logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=7
